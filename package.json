{
  "name": "spec-flow-plugin",
  "version": "0.1.0",
  "type": "module",
  "description": "spec-flow: the engine half of a spec-driven multi-agent pipeline for Claude Code. Ships as a plugin (hooks/commands/agents) AND as an installable CLI (bin/spec-flow), so the same checks run from Claude Code, a human's terminal, and CI.",
  "bin": {
    "spec-flow": "./bin/spec-flow.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IgnacioMarin402/spec-flow-plugin.git"
  },
  "homepage": "https://github.com/IgnacioMarin402/spec-flow-plugin#readme",
  "bugs": {
    "url": "https://github.com/IgnacioMarin402/spec-flow-plugin/issues"
  },
  "files": [
    "bin",
    "scripts",
    "hooks",
    "commands",
    "agents",
    "skills",
    ".claude-plugin"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node scripts/no-repo-refs.mjs",
    "paths:check": "node scripts/plugin-paths.mjs",
    "decisions:check": "node scripts/decisions.mjs",
    "agents:check": "node scripts/agent-contracts.mjs",
    "skill:check": "node scripts/skill-contract.mjs",
    "pack:check": "node scripts/package-fixture.mjs",
    "gate:check": "node scripts/gate-fixture.mjs",
    "hooks:check": "node scripts/hook-smoke.mjs",
    "cold:check": "node scripts/cold-start.mjs",
    "trace:check": "node scripts/spec-trace-fixture.mjs",
    "report:check": "node scripts/test-report-fixture.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "init:check": "node scripts/init-fixture.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "eslint": "^9.9.0",
    "typescript": "^5.5.0"
  },
  "license": "MIT"
}
