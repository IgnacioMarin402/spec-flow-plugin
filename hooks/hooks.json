{
  "description": "spec-flow — the external gate and state machine for the spec-driven multi-agent pipeline. See commands/spec-flow.md and commands/spec-fix.md.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/spec-flow\" hook human-turn" }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/spec-flow\" hook session-start" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/spec-flow\" hook no-gate-cmds", "onFailure": "continue" }
        ]
      },
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/spec-flow\" hook phase-guard", "onFailure": "continue" }
        ]
      },
      {
        "matcher": "Read|Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/spec-flow\" hook orchestrator-scope", "onFailure": "continue" }
        ]
      },
      {
        "matcher": "Task|Agent|SendMessage",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/spec-flow\" hook preflight", "onFailure": "continue" },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/spec-flow\" hook opus-budget", "onFailure": "continue" },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/spec-flow\" hook arm-gate", "onFailure": "continue" },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/spec-flow\" hook dispatch-guard", "onFailure": "continue" }
        ]
      },
      {
        "matcher": "Task|Agent",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/spec-flow\" hook model-route", "onFailure": "continue" }
        ]
      },
      {
        "matcher": "SendMessage",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/spec-flow\" hook stale-resume", "onFailure": "continue" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/spec-flow\" hook lint-on-write" }
        ]
      },
      {
        "matcher": "Task|Agent",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/spec-flow\" hook register-agent" }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/spec-flow\" hook human-turn" }
        ]
      },
      {
        "matcher": "Write|Edit|Read|Bash",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/spec-flow\" hook run-trace" }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/spec-flow\" hook run-trace" }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/spec-flow\" hook run-trace" },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/spec-flow\" hook agent-gate" }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/spec-flow\" hook token-trace" },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/spec-flow\" hook human-turn" },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/spec-flow\" hook gate", "timeout": 1800 }
        ]
      }
    ]
  },
  "modules": ["./live-view.tsx"]
}
