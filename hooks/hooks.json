{
  "description": "spec-flow — the external gate and state machine for the spec-driven multi-agent pipeline. See commands/spec-flow.md and commands/spec-fix.md.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/spec-flow", "args": ["hook", "human-turn"] }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/spec-flow", "args": ["hook", "session-start"] }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/spec-flow", "args": ["hook", "no-gate-cmds"] }
        ]
      },
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/spec-flow", "args": ["hook", "phase-guard"] }
        ]
      },
      {
        "matcher": "Read|Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/spec-flow", "args": ["hook", "orchestrator-scope"] }
        ]
      },
      {
        "matcher": "Task|Agent|SendMessage",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/spec-flow", "args": ["hook", "preflight"] },
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/spec-flow", "args": ["hook", "opus-budget"] },
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/spec-flow", "args": ["hook", "arm-gate"] },
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/spec-flow", "args": ["hook", "dispatch-guard"] }
        ]
      },
      {
        "matcher": "Task|Agent",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/spec-flow", "args": ["hook", "model-route"] }
        ]
      },
      {
        "matcher": "SendMessage",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/spec-flow", "args": ["hook", "stale-resume"] }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/spec-flow", "args": ["hook", "lint-on-write"] }
        ]
      },
      {
        "matcher": "Task|Agent",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/spec-flow", "args": ["hook", "register-agent"] }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/spec-flow", "args": ["hook", "human-turn"] }
        ]
      },
      {
        "matcher": "Write|Edit|Read|Bash",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/spec-flow", "args": ["hook", "run-trace"] }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/spec-flow", "args": ["hook", "run-trace"] }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/spec-flow", "args": ["hook", "run-trace"] },
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/spec-flow", "args": ["hook", "agent-gate"] }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/spec-flow", "args": ["hook", "token-trace"] },
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/spec-flow", "args": ["hook", "human-turn"] },
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/spec-flow", "args": ["hook", "gate"], "timeout": 1800 }
        ]
      }
    ]
  },
  "modules": ["./live-view.tsx"]
}
