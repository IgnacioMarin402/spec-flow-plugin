{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "es2022",
    "moduleResolution": "bundler",
    "target": "es2022",
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["hooks/**/*.mjs", "scripts/**/*.mjs", "bin/**/*.mjs", "test/**/*.mjs"]
}
